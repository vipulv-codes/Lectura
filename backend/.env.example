# Copy to backend/.env (gitignored). Loaded by main.py and by the eval runners.

# Used by the evaluation harness, and as a server-side fallback when the UI
# does not send an X-Gemini-API-Key header.
GEMINI_API_KEY=

# Everything below is optional; defaults are shown.
# LECTURA_DATA_DIR=./data
# LECTURA_HOST=127.0.0.1
# LECTURA_PORT=8000
# LECTURA_LOG_LEVEL=INFO
# LECTURA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# LECTURA_MAX_PLAYLIST_VIDEOS=500
# LECTURA_WHISPER_MODEL=tiny.en
# LECTURA_DEVICE=auto            # auto | cuda | cpu

# Index identity (changing these builds a new collection)
# LECTURA_CHILD_SECS=30
# LECTURA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# LECTURA_DOC_PREFIX=
# LECTURA_QUERY_PREFIX=
# LECTURA_SPACE=cosine

# Query-time retrieval
# LECTURA_STRATEGY=dense         # dense | bm25 | hybrid
# LECTURA_CANDIDATE_K=20
# LECTURA_RERANKER=              # e.g. cross-encoder/ms-marco-MiniLM-L-6-v2
# LECTURA_TOP_K=4
# LECTURA_TOP_K_PLAYLIST=8
# LECTURA_MIN_SCORE=             # relevance gate; empty disables
# LECTURA_PARENT_SECS=120

# Generation
# LECTURA_GEMINI_MODEL=gemini-2.5-flash
# LECTURA_TEMPERATURE=0.2
# LECTURA_THINKING_BUDGET=       # 0 disables thinking
# LECTURA_CONTEXT_ORDER=time     # time | rank
